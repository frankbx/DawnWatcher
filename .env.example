REGIMEBEACON_ENVIRONMENT=development
REGIMEBEACON_LOG_LEVEL=INFO
REGIMEBEACON_TIMEZONE=Asia/Shanghai
REGIMEBEACON_DATA_DIR=data
REGIMEBEACON_DATABASE_FILENAME=regimebeacon.sqlite3
REGIMEBEACON_SQLITE_BUSY_TIMEOUT_MS=5000
REGIMEBEACON_MARKET_REQUEST_TIMEOUT_SECONDS=8
REGIMEBEACON_MARKET_BATCH_SIZE=50
REGIMEBEACON_MARKET_POLL_INTERVAL_SECONDS=15
REGIMEBEACON_TUSHARE_TOKEN_FILE=token
REGIMEBEACON_TUSHARE_API_URL=https://api.tushare.pro
REGIMEBEACON_TRADING_CALENDAR_EXCHANGE=SSE
REGIMEBEACON_TRADING_CALENDAR_REFRESH_HOURS=24
REGIMEBEACON_CIRCUIT_FAILURE_THRESHOLD=3
REGIMEBEACON_CIRCUIT_COOLDOWN_SECONDS=60
REGIMEBEACON_ARCHIVE_RAW_QUOTES=true
REGIMEBEACON_MONITOR_INTERVAL_SECONDS=30
REGIMEBEACON_HEARTBEAT_STALE_SECONDS=60
REGIMEBEACON_COLLECTION_GAP_SECONDS=60
REGIMEBEACON_DISK_CRITICAL_FREE_BYTES=1073741824
REGIMEBEACON_DISK_WARNING_FREE_BYTES=5368709120
REGIMEBEACON_ALERT_CHANNEL=feishu
REGIMEBEACON_ALERT_RECIPIENT=operators
REGIMEBEACON_FEISHU_WEBHOOK_FILE=feishu_webhook
REGIMEBEACON_FEISHU_SIGNING_SECRET_FILE=feishu_secret
REGIMEBEACON_FEISHU_REQUEST_TIMEOUT_SECONDS=8
REGIMEBEACON_NOTIFICATION_POLL_INTERVAL_SECONDS=5
REGIMEBEACON_NOTIFICATION_BATCH_SIZE=20
REGIMEBEACON_NOTIFICATION_LEASE_SECONDS=30
REGIMEBEACON_NOTIFICATION_RETRY_BASE_SECONDS=30
REGIMEBEACON_NOTIFICATION_RETRY_MAX_SECONDS=1800
REGIMEBEACON_ACCEPTANCE_MIN_VALID_QUOTE_RATE_PCT=99.5
REGIMEBEACON_ACCEPTANCE_MIN_SUCCESSFUL_RUN_RATE_PCT=99.0
REGIMEBEACON_ACCEPTANCE_MAX_P95_LATENCY_MS=15000
REGIMEBEACON_ACCEPTANCE_MAX_GAP_SECONDS=60
