DAWNWATCHER_ENVIRONMENT=development
DAWNWATCHER_LOG_LEVEL=INFO
DAWNWATCHER_TIMEZONE=Asia/Shanghai
DAWNWATCHER_DATA_DIR=data
DAWNWATCHER_DATABASE_FILENAME=dawnwatcher.sqlite3
DAWNWATCHER_SQLITE_BUSY_TIMEOUT_MS=5000
DAWNWATCHER_MARKET_REQUEST_TIMEOUT_SECONDS=8
DAWNWATCHER_MARKET_BATCH_SIZE=50
DAWNWATCHER_MARKET_POLL_INTERVAL_SECONDS=15
DAWNWATCHER_TUSHARE_TOKEN_FILE=token
DAWNWATCHER_TUSHARE_API_URL=https://api.tushare.pro
DAWNWATCHER_TRADING_CALENDAR_EXCHANGE=SSE
DAWNWATCHER_TRADING_CALENDAR_REFRESH_HOURS=24
DAWNWATCHER_CIRCUIT_FAILURE_THRESHOLD=3
DAWNWATCHER_CIRCUIT_COOLDOWN_SECONDS=60
DAWNWATCHER_ARCHIVE_RAW_QUOTES=true
